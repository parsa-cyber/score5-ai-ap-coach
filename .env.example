# Required for AI tutor / FRQ / screenshot analysis
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.1-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for real accounts, email verification codes, Google sign-in, and Pro status
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# Server-only Supabase key for Stripe webhooks.
# NEVER put this in frontend code. Add it only to .env.local locally and Vercel Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Required for paid Pro checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_here
STRIPE_SECRET_KEY=sk_test_or_sk_live_here
STRIPE_WEBHOOK_SECRET=whsec_here
STRIPE_PRO_PRICE_ID=price_monthly_pro_here
STRIPE_CRAM_PRICE_ID=price_one_time_cram_here
